# ========================================================
# VertaFlow AI Closer — Environment Configuration Template
# ========================================================
# Duplicate this file to .env and configure your variables:
# cp .env.example .env

# Google Gemini API Key (Required for AI Closer engine)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hybrid LLM Provider Options (Fallback or primary: openai, groq, openrouter)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Telegram Omnichannel Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SALES_MANAGER_CHAT_ID=your_manager_telegram_chat_id

# Meta (Instagram Direct & WhatsApp Cloud API) Integration
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token
META_VERIFY_TOKEN=your_custom_verify_token

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://vertaflow.uz

# Server Settings
HOST=0.0.0.0
PORT=8000
